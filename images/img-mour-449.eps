%%Creator: (ImageMagick)
%%Title: (img-mour-463.eps)
%%CreationDate: (2021-02-27T09:47:43+00:00)
%%BoundingBox: -0 -0 1000 1000
%%HiResBoundingBox: 0 0 1000 1000
